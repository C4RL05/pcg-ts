{
  "_comment": "Panel spec \u2014 presentation only; the graph cooks identically without it. See examples/shared/graphUi.ts.",
  "sections": [
    {
      "title": "surface",
      "controls": [
        {
          "param": "ground.size",
          "label": "size"
        },
        {
          "param": "ground.subdivisions",
          "label": "subdivisions"
        }
      ]
    },
    {
      "title": "samples",
      "controls": [
        {
          "param": "scatter.count",
          "label": "points",
          "min": 50,
          "max": 2000,
          "step": 25
        },
        {
          "param": "scatter.seed",
          "label": "seed"
        },
        {
          "param": "sampleDown.mapping",
          "label": "mapping"
        },
        {
          "param": "sampleDown.direction",
          "label": "direction"
        },
        {
          "param": "sampleDown.maxDistance",
          "label": "max distance",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": " m"
        }
      ]
    }
  ]
}
