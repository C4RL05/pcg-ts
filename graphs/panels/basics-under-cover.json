{
  "_comment": "Panel spec — presentation only; the graph cooks identically without it. See shared/graphUi.ts.",
  "sections": [
    {
      "title": "the route",
      "controls": [
        { "param": "coil.turns", "label": "turns", "min": 1, "max": 6, "step": 1 },
        {
          "param": "lap.spacing",
          "label": "sample spacing",
          "min": 0.3,
          "max": 3,
          "step": 0.1,
          "unit": " m"
        },
        {
          "param": "stations.spacing",
          "label": "panel spacing",
          "min": 2,
          "max": 10,
          "step": 0.5,
          "unit": " m"
        }
      ]
    },
    {
      "title": "the fan",
      "controls": [
        { "param": "cover.rayCount", "label": "rays", "min": 1, "max": 12, "step": 1 },
        {
          "param": "cover.spread",
          "label": "half span",
          "min": 0,
          "max": 6,
          "step": 0.1,
          "unit": " m"
        },
        { "param": "cover.minHits", "label": "rays needed", "min": 1, "max": 6, "step": 1 }
      ]
    },
    {
      "title": "the ceiling",
      "controls": [
        {
          "param": "cover.near",
          "label": "ray start",
          "min": -2,
          "max": 6,
          "step": 0.1,
          "unit": " m"
        },
        {
          "param": "cover.far",
          "label": "ray end",
          "min": 1,
          "max": 40,
          "step": 0.5,
          "unit": " m"
        },
        { "param": "cover.boxSize", "label": "asset extent" }
      ]
    }
  ]
}
