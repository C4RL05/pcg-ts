{
  "_comment": "Panel spec for basics-compose-primitives. Presentation only: which of the graph's exposed params to show, in what order, under what name, and over what range. The graph cooks identically without this file. See shared/graphUi.ts.",
  "sections": [
    {
      "title": "scatter",
      "controls": [
        { "param": "scatter.count", "label": "points", "min": 200, "max": 20000, "step": 100 },
        {
          "param": "scatter.minDistance",
          "label": "spacing",
          "min": 0,
          "max": 6,
          "step": 0.1,
          "unit": " m"
        },
        { "param": "scatter.seed", "label": "seed" }
      ]
    },
    {
      "title": "mask",
      "controls": [
        { "param": "mask.threshold", "label": "keep above", "min": 0, "max": 1, "step": 0.01 },
        { "param": "mask.frequency", "label": "noise scale", "min": 0.005, "max": 0.2, "step": 0.005 },
        { "param": "mask.variant", "label": "variant", "min": 0, "max": 20, "step": 1 }
      ]
    },
    {
      "title": "size",
      "controls": [
        { "param": "size.min", "label": "smallest", "min": 0.1, "max": 3, "step": 0.05, "unit": "×" },
        { "param": "size.max", "label": "largest", "min": 0.1, "max": 5, "step": 0.05, "unit": "×" },
        { "param": "size.seed", "label": "seed" }
      ]
    }
  ]
}
