{
  "name": "pcg-ts",
  "version": "0.16.0",
  "description": "Deterministic procedural content generation for TypeScript: domain attributes, node graphs, deferred fields, hierarchical streaming. Optional three.js interop.",
  "license": "MIT",
  "author": "C4RL05 <carlos@helloenjoy.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C4RL05/pcg-ts.git"
  },
  "homepage": "https://c4rl05.github.io/pcg-ts/",
  "bugs": "https://github.com/C4RL05/pcg-ts/issues",
  "keywords": [
    "procedural-generation",
    "pcg",
    "node-graph",
    "deterministic",
    "noise",
    "scattering",
    "instancing",
    "threejs",
    "typescript",
    "ai-agents"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "pcg": "bin/pcg.mjs"
  },
  "files": [
    "bin",
    "dist",
    "llms.txt",
    "docs/nodes.md",
    "docs/nodes.json",
    "docs/primitives.md",
    "docs/primitives.json",
    "docs/authoring.md",
    "docs/design.md",
    "docs/graphs.md",
    "docs/graphs.json",
    "graphs/basics-*.json",
    "graphs/pipeline-*.json",
    "skills"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js"
    },
    "./gpu": {
      "types": "./dist/gpu/index.d.ts",
      "import": "./dist/gpu/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./worker/node": {
      "types": "./dist/worker/entryNode.d.ts",
      "import": "./dist/worker/entryNode.js"
    },
    "./worker/browser": {
      "types": "./dist/worker/entryBrowser.d.ts",
      "import": "./dist/worker/entryBrowser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "check": "tsc --noEmit && svelte-check --threshold error",
    "examples": "vite",
    "examples:pages": "node scripts/clean-pages.mjs && vite build --base=./",
    "capture": "node scripts/capture-demos.mjs",
    "capture:gallery": "node scripts/capture-gallery.mjs",
    "preview": "node scripts/preview.mjs",
    "docs": "npm run docs:nodes && npm run docs:primitives && npm run docs:graphs && npm run docs:gallery && npm run docs:site",
    "docs:nodes": "node scripts/gen-node-reference.mjs",
    "docs:primitives": "node scripts/gen-primitives.mjs",
    "docs:graphs": "node scripts/gen-graphs.mjs",
    "docs:gallery": "node scripts/gen-gallery.mjs",
    "docs:site": "node scripts/gen-site.mjs",
    "graphs:golden": "node scripts/gen-graphs-golden.mjs",
    "prepublishOnly": "npm run check && npm test && npm run build && node scripts/smoke-dist.mjs"
  },
  "peerDependencies": {
    "three": "^0.185.1"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.3",
    "puppeteer": "^25.5.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.6",
    "three": "^0.185.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "webgpu": "^0.4.0"
  }
}
